{
  "Outbox": {
    "BatchSize": 20,
    "IntervalSeconds": 5,
    "MaxAttempts": 5
  },
  "RabbitMQ": {
    "Port": 5672,
    "VirtualHost": "/",
    "ExchangeName": "fleetops.events",
    "DeadLetterExchangeName": "fleetops.events.dlx",
    "MaintenanceQueueName": "fleetops.vehicle-maintenance.completed",
    "MaintenanceDlqName": "fleetops.vehicle-maintenance.completed.dlq",
    "MaxRetryAttempts": 3,
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "FleetOps_Super_Secret_Jwt_Signing_Key_2026_Minimum_256_Bits!",
    "Issuer": "FleetOps.Api",
    "Audience": "FleetOps.Clients",
    "ExpirationHours": 8
  }
}
