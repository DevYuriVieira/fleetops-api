# FleetOps API - Local Development Environment Variables
# Copy this file to .env to override defaults for local development:
# cp .env.example .env

# ASP.NET Core API Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# PostgreSQL Development Database Configuration
POSTGRES_PORT=5432
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops_dev
POSTGRES_PASSWORD=fleetops_dev_secret
